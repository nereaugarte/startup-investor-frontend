{
  "LambdaFunctionConfigurations": [
    {
      "Id": "ThumbnailGeneratorTrigger",
      "LambdaFunctionArn": "arn:aws:lambda:eu-north-1:459329362476:function:startup-investor-platform-dev-thumbnail-generator",
      "Events": ["s3:ObjectCreated:*"],
      "Filter": {
        "Key": {
          "FilterRules": [
            {
              "Name": "prefix",
              "Value": "uploads/"
            },
            {
              "Name": "suffix",
              "Value": ".jpg"
            }
          ]
        }
      }
    },
    {
      "Id": "ThumbnailGeneratorTriggerPNG",
      "LambdaFunctionArn": "arn:aws:lambda:eu-north-1:459329362476:function:startup-investor-platform-dev-thumbnail-generator",
      "Events": ["s3:ObjectCreated:*"],
      "Filter": {
        "Key": {
          "FilterRules": [
            {
              "Name": "prefix",
              "Value": "uploads/"
            },
            {
              "Name": "suffix",
              "Value": ".png"
            }
          ]
        }
      }
    }
  ]
}

